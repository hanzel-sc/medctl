# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Testing and linting
.pytest_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
*.cover
*.py,cover
.ruff_cache/
.mypy_cache/

# IDE and editor settings
.idea/
.vscode/
*.swp
*.swo
*~

# Operating System files
.DS_Store
Thumbs.db
desktop.ini

# Medical Imaging Data & Outputs (HIPAA / Security Prevention)
# Never commit real or working medical datasets, converted images, or run artifacts
data/
datasets/
raw_data/
processed_data/
output/
outputs/
runs/
reports/
converted/
anonymized/
preview/

# Direct DICOM and generated image file safety net
*.dcm
*.dicom
*.png
*.jpg
*.jpeg
# Exception: keep any documentation/architecture images in the root or docs
!architecture.png
!docs/*.png

# Sensitive keys, salts, logs
*.log
*.salt
salt.txt
